configuration {
    font: "JetBrains Mono 11";
    show-icons: false;
    disable-history: true;
    sleek: true;
}

* {
    background-color: #11111b;
    text-color: #cdd6f4;
}

window {
    transparency: "real";
    background-color: #11111b;
    text-color: #cdd6f4;
    border: 2px;
    border-color: #313244;
    border-radius: 12px;
    width: 250px;
    location: center;
    anchor: center;
    x-offset: 0;
    y-offset: 0;
}

mainbox {
    background-color: #11111b;
    children: [ inputbar, listview ];
    spacing: 10px;
    padding: 15px;
}

inputbar {
    background-color: #181825;
    text-color: #cdd6f4;
    padding: 8px;
    border-radius: 8px;
    children: [ prompt ];
}

prompt {
    background-color: transparent;
    text-color: #cdd6f4;
    enabled: true;
    padding: 0px;
}

listview {
    background-color: #11111b;
    lines: 7;
    columns: 1;
    spacing: 5px;
    cycle: true;
    dynamic: true;
    scrollbar: false;
}

element {
    background-color: transparent;
    text-color: #cdd6f4;
    padding: 10px;
    border-radius: 6px;
}

element selected {
    background-color: #45475a;
    text-color: #cdd6f4;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    cursor: inherit;
    vertical-align: 0.5;
    horizontal-align: 0.0;
}
